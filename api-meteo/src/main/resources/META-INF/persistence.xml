<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="meteo" transaction-type="JTA">
        <!-- il collegamento al database definito in web.xml -->
        <jta-data-source>java:app/jdbc/meteo</jta-data-source>
        <class>meteo.api.Misura</class>
        <shared-cache-mode>NONE</shared-cache-mode>
        <properties>
            <!-- JPA non crea e non modifica tabelle: lo fa solo l'archivio -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
